{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "vivify-automation-mcp",
      "version": "0.1.0",
      "title": "VIVIFY Automation"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List every automation case study VIVIFY has shipped. Returns id, title, tag, one-line summary, and tech stack for each.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "stack": {
              "description": "Optional tech to filter by, e.g. 'n8n', 'Gemini', 'VAPI'.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Get project case study",
        "description": "Return the full case study (problem, solution, result, stack) for one VIVIFY project by id. Use list_projects first to discover ids.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Project id from list_projects, e.g. 'fb-messenger-agent'."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_services",
        "title": "Get services",
        "description": "Return the automation services VIVIFY offers and the platforms Viviene works across.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_contact_info",
        "title": "Get contact info",
        "description": "Return the public contact channels for VIVIFY Automation (email, website, LinkedIn, OnlineJobs.ph).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_about",
        "title": "Get about VIVIFY",
        "description": "Return the short bio, brand info, and headline impact metrics for VIVIFY Automation / Viviene Pitogo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
